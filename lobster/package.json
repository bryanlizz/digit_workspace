{
  "name": "lobster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @lobster/db generate",
    "db:push": "pnpm --filter @lobster/db push",
    "db:studio": "pnpm --filter @lobster/db studio"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@9.15.0"
}
