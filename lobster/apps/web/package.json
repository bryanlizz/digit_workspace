{
  "name": "@lobster/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./dist/server/api/root.d.ts",
      "default": "./src/server/api/root.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build-types.json",
    "build": "pnpm build:types && next build",
    "dev": "next dev --turbo --port 3000",
    "dev:admin": "cross-env NEXT_PUBLIC_APP_MODE=admin next dev --turbo --port 3001",
    "dev:enterprise": "cross-env NEXT_PUBLIC_APP_MODE=enterprise next dev --turbo --port 3002",
    "dev:desktop": "cross-env NEXT_PUBLIC_APP_MODE=desktop next dev --turbo --port 3003",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lobster/api": "workspace:*",
    "@lobster/db": "workspace:*",
    "@lobster/types": "workspace:*",
    "@lobster/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/next": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "lucide-react": "^1.21.0",
    "next": "^15.2.3",
    "next-auth": "4",
    "nodemailer": "^6.10.1",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.1",
    "three": "^0.185.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2"
  }
}
